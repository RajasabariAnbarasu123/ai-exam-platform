{
  "name": "ai-exam-platform-frontend",
  "version": "1.0.0",
  "description": "AI-Powered Smart Exam Platform - Frontend Application",
  "private": true,
  "author": "AI Exam Team",
  "license": "MIT",
  "homepage": "https://aiexam.com",
  "repository": {
    "type": "git",
    "url": "https://github.com/yourusername/ai-exam-platform"
  },
  "scripts": {
    "start": "react-scripts start",
    "build": "react-scripts build",
    "test": "react-scripts test",
    "eject": "react-scripts eject",
    "lint": "eslint src/**/*.{js,jsx}",
    "lint:fix": "eslint src/**/*.{js,jsx} --fix",
    "format": "prettier --write src/**/*.{js,jsx,css,json}",
    "analyze": "source-map-explorer 'build/static/js/*.js'",
    "preview": "serve -s build",
    "docker:build": "docker build -t ai-exam-platform-frontend .",
    "docker:run": "docker run -p 3000:3000 ai-exam-platform-frontend"
  },
  "dependencies": {
    "@headlessui/react": "^1.7.17",
    "@heroicons/react": "^2.0.18",
    "axios": "^1.4.0",
    "chart.js": "^4.4.0",
    "date-fns": "^2.30.0",
    "framer-motion": "^10.12.0",
    "lucide-react": "^0.263.0",
    "react": "^18.2.0",
    "react-chartjs-2": "^5.2.0",
    "react-dom": "^18.2.0",
    "react-helmet-async": "^2.0.0",
    "react-hook-form": "^7.45.0",
    "react-hot-toast": "^2.4.0",
    "react-query": "^3.39.3",
    "react-router-dom": "^6.14.0",
    "react-toastify": "^9.1.0",
    "recharts": "^2.7.0"
  },
  "devDependencies": {
    "@tailwindcss/aspect-ratio": "^0.4.2",
